--- !u!114 &963000000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 205093987}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a179ec645311e874ba6d26be587cf8e2, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::ManualLocalizedText
  ukrainianText: "\u0423 \u043A\u043D\u0438\u0437\u0456 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C \u0454 5
    \u0441\u0442\u043E\u0440\u0456\u043D\u043E\u043A, \u043F\u043E 15
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C \u043D\u0430 \u043A\u043E\u0436\u043D\u0456\u0439.
    \u0414\u043B\u044F \u043A\u043E\u0436\u043D\u043E\u0433\u043E
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043C\u043E\u0436\u043D\u0430
    \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u0438 \u043D\u0430\u0437\u0432\u0443 \u0439 \u043E\u043F\u0438\u0441,
    \u043F\u043E\u0437\u043D\u0430\u0447\u0438\u0442\u0438, \u0447\u0438 \u0432\u043E\u043D\u043E
    \u043F\u0456\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0435, \u0430 \u0442\u0430\u043A\u043E\u0436
    \u0443\u043A\u0430\u0437\u0430\u0442\u0438 \u0440\u0456\u0432\u0435\u043D\u044C,
    \u0442\u0440\u0438\u0432\u0430\u043B\u0456\u0441\u0442\u044C \u0456 \u0447\u0430\u0441
    \u043D\u0430\u043A\u043B\u0430\u0434\u0430\u043D\u043D\u044F (\u0434\u0456\u044F,
    \u0431\u043E\u043D\u0443\u0441\u043D\u0430 \u0434\u0456\u044F, \u0440\u0435\u0430\u043A\u0446\u0456\u044F
    \u0430\u0431\u043E \u0440\u0438\u0442\u0443\u0430\u043B).\n\n\u041A\u043D\u0438\u0433\u0430
    \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0454 \u0442\u0440\u0438\u043C\u0430\u0442\u0438
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u043A\u043E\u0436\u043D\u043E\u0433\u043E
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u043E\u043A\u0440\u0435\u043C\u043E.
    \u042F\u043A\u0449\u043E \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430
    \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043E \u0447\u0435\u0440\u0435\u0437
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440, \u0432\u0456\u0434\u043E\u043C\u0456
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F
    \u0437\u0430\u043F\u0438\u0441\u0443\u044E\u0442\u044C\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E."
  englishText: "The spellbook has 5 pages with 15 spells on each. For each spell, you can enter a name and description, mark it
    as prepared, and specify its level, duration, and casting time (action, bonus action, reaction, or
    ritual).\n\nThe spellbook keeps each character\u2019s spells separate. If you create a character with the
    generator, their known spells are added automatically."
  russianText: "\u0412 \u043A\u043D\u0438\u0433\u0435 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439 5
    \u0441\u0442\u0440\u0430\u043D\u0438\u0446, \u043F\u043E 15
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439 \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u0439.
    \u0414\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F \u043C\u043E\u0436\u043D\u043E
    \u0443\u043A\u0430\u0437\u0430\u0442\u044C \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0438
    \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435, \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C,
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043E \u043B\u0438 \u043E\u043D\u043E, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u0437\u0430\u0434\u0430\u0442\u044C \u0443\u0440\u043E\u0432\u0435\u043D\u044C,
    \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438 \u0432\u0440\u0435\u043C\u044F
    \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043D\u0438\u044F
    (\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u0431\u043E\u043D\u0443\u0441\u043D\u043E\u0435
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u0440\u0435\u0430\u043A\u0446\u0438\u044F \u0438\u043B\u0438
    \u0440\u0438\u0442\u0443\u0430\u043B).\n\n\u041A\u043D\u0438\u0433\u0430
    \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0445\u0440\u0430\u043D\u0438\u0442\u044C
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E.
    \u0415\u0441\u043B\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u0441\u043E\u0437\u0434\u0430\u043D
    \u0432 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0435,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u0435\u043C\u0443
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F
    \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438."
  useCurrentTextAsSource: 0
--- !u!114 &963000001
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 362618112}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a179ec645311e874ba6d26be587cf8e2, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::ManualLocalizedText
  ukrainianText: "\u0422\u0443\u0442 \u043C\u043E\u0436\u043D\u0430 \u0432\u043A\u0430\u0437\u0430\u0442\u0438
    \u0437\u0430\u0433\u0430\u043B\u044C\u043D\u0443 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
    \u043A\u043E\u043C\u0456\u0440\u043E\u043A \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C \u0456
    \u0432\u0456\u0434\u043C\u0456\u0447\u0430\u0442\u0438
    \u0432\u0438\u0442\u0440\u0430\u0447\u0435\u043D\u0456.\n\n\u0422\u0430\u043A \u0441\u0430\u043C\u043E
    \u043F\u0440\u0430\u0446\u044E\u0454 \u043E\u0431\u043B\u0456\u043A \u0456\u043D\u0444\u0443\u0437\u0456\u0439:
    \u043C\u043E\u0436\u043D\u0430 \u0432\u043A\u0430\u0437\u0430\u0442\u0438 \u0457\u0445\u043D\u044E
    \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C, \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u0438
    \u043D\u0430\u0437\u0432\u0438 \u0439 \u0432\u0456\u0434\u043C\u0456\u0442\u0438\u0442\u0438
    \u0430\u043A\u0442\u0438\u0432\u043D\u0456. \u0422\u0443\u0442 \u0442\u0430\u043A\u043E\u0436
    \u043C\u043E\u0436\u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0443\u0432\u0430\u0442\u0438
    \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0438 \u0439 \u0443\u043C\u0456\u043D\u043D\u044F \u0437
    \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u043E\u044E \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044E
    \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u044C \u0442\u0430
    \u0432\u0456\u0434\u043C\u0456\u0447\u0430\u0442\u0438, \u0441\u043A\u0456\u043B\u044C\u043A\u0438
    \u0440\u0430\u0437\u0456\u0432 \u0457\u0445 \u0443\u0436\u0435
    \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E.
    \u0411\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u0442\u0430\u043A\u0438\u0445
    \u0443\u043C\u0456\u043D\u044C \u0443\u0436\u0435 \u0454 \u043D\u0430
    \u0433\u043E\u043B\u043E\u0432\u043D\u0456\u0439 \u0441\u0442\u043E\u0440\u0456\u043D\u0446\u0456
    \u043A\u0430\u0440\u0442\u0438, \u0430 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u0437\u0430\u043F\u043E\u0432\u043D\u044E\u0454 \u0457\u0445
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E. \u0414\u0435\u044F\u043A\u0456
    \u0456\u043D\u0444\u0443\u0437\u0456\u0457 \u0442\u0430 \u0432\u043C\u0456\u043D\u043D\u044F
    \u0432\u043F\u043B\u0438\u0432\u0430\u044E\u0442\u044C \u043D\u0430 \u043A\u0430\u0440\u0442\u0443
    \u043F\u0456\u0441\u043B\u044F \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0456\u0457.
    \u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0456\u043D\u0444\u0443\u0437\u0456\u044F
    \u0449\u0438\u0442\u0430 \u0434\u043E\u0434\u0430\u0454
    \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u0439 \u0431\u043E\u043D\u0443\u0441 \u0434\u043E
    \u043A\u043B\u0430\u0441\u0443 \u043E\u0431\u043B\u0430\u0434\u0443\u043D\u043A\u0443
    (\u041A\u041E).\n\n\u041A\u043D\u043E\u043F\u043A\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0443
    \u0434\u043E \u043A\u043D\u0438\u0433\u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C \u0454
    \u0432\u043D\u0438\u0437\u0443 \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0438 \u0439 \u0443
    \u043C\u0435\u043D\u044E."
  englishText: "Here you can set your total number of spell slots and mark the ones you\u2019ve used.\n\nInfusions work the same
    way: enter how many you have, record their names, and mark which ones are active. You can also track magic items
    and features with limited uses. Most such features are already on the main character sheet, and the generator
    fills them in automatically. Some infusions and features affect your character sheet when activated. For example,
    a shield infusion adds the corresponding bonus to Armor Class (AC).\n\nYou can open the spellbook from the bottom
    of the page or from the menu."
  russianText: "\u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u0443\u043A\u0430\u0437\u0430\u0442\u044C
    \u043E\u0431\u0449\u0435\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u044F\u0447\u0435\u0435\u043A \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439 \u0438
    \u043E\u0442\u043C\u0435\u0447\u0430\u0442\u044C
    \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u0435.\n\n\u0423\u0447\u0451\u0442
    \u0438\u043D\u0444\u0443\u0437\u0438\u0439 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0442\u0430\u043A
    \u0436\u0435: \u043C\u043E\u0436\u043D\u043E \u0443\u043A\u0430\u0437\u0430\u0442\u044C \u0438\u0445
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E, \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u0438 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C
    \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435. \u0417\u0434\u0435\u0441\u044C \u0442\u0430\u043A\u0436\u0435
    \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C
    \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
    \u0438 \u0443\u043C\u0435\u043D\u0438\u044F \u0441
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u043C
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C
    \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0439 \u0438
    \u043E\u0442\u043C\u0435\u0447\u0430\u0442\u044C, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437
    \u043E\u043D\u0438 \u0443\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B.
    \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0442\u0430\u043A\u0438\u0445
    \u0443\u043C\u0435\u043D\u0438\u0439 \u0443\u0436\u0435 \u0435\u0441\u0442\u044C \u043D\u0430
    \u0433\u043B\u0430\u0432\u043D\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435
    \u043B\u0438\u0441\u0442\u0430, \u0430 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0438\u0445
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.
    \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u043D\u0444\u0443\u0437\u0438\u0438 \u0438
    \u0443\u043C\u0435\u043D\u0438\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u043D\u0430
    \u043B\u0438\u0441\u0442 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u043F\u043E\u0441\u043B\u0435
    \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0438\u043D\u0444\u0443\u0437\u0438\u044F \u0449\u0438\u0442\u0430
    \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
    \u0431\u043E\u043D\u0443\u0441 \u043A \u043A\u043B\u0430\u0441\u0441\u0443
    \u0434\u043E\u0441\u043F\u0435\u0445\u0430 (\u041A\u0414).\n\n\u041A\u043D\u0438\u0433\u0443
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439 \u043C\u043E\u0436\u043D\u043E
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
    \u043A\u043D\u043E\u043F\u043A\u0438 \u0432\u043D\u0438\u0437\u0443
    \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B \u0438\u043B\u0438 \u0432 \u043C\u0435\u043D\u044E."
  useCurrentTextAsSource: 0
--- !u!114 &963000002
MonoBehaviour:
