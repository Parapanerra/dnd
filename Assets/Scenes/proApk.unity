  ukrainianText: "\u0412 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0456 \u0454 5
    \u0441\u0442\u043E\u0440\u0456\u043D\u043E\u043A, \u043F\u043E 9
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0456\u0432 \u043D\u0430 \u043A\u043E\u0436\u043D\u0456\u0439.
    \u0414\u043B\u044F \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430 \u043C\u043E\u0436\u043D\u0430
    \u043E\u0431\u0440\u0430\u0442\u0438 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u044E:
    \u0437\u0431\u0440\u043E\u044F, \u043E\u0431\u043B\u0430\u0434\u0443\u043D\u043E\u043A,
    \u0441\u0443\u043C\u043A\u0438, \u043C\u0430\u0433\u0456\u0447\u043D\u0456
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438, \u0440\u0456\u0437\u043D\u0435 \u0430\u0431\u043E
    \u0432\u043B\u0430\u0441\u043D\u0435 \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F.\n\n\u0423
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457 \u00AB\u0412\u043B\u0430\u0441\u043D\u0435
    \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F\u00BB \u043C\u043E\u0436\u043D\u0430
    \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438
    \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443 \u0437 \u0433\u0430\u043B\u0435\u0440\u0435\u0457. \u0412
    \u0456\u043D\u0448\u0438\u0445 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u044F\u0445
    \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u043D\u0430
    \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430,
    \u0449\u043E\u0431 \u0432\u0438\u0431\u0440\u0430\u0442\u0438 \u0456\u043A\u043E\u043D\u043A\u0443 \u0437\u0456
    \u0441\u043F\u0438\u0441\u043A\u0443.\n\n\u041A\u043D\u043E\u043F\u043A\u0438 \u0437
    \u0431\u043E\u043A\u0456\u0432 \u0434\u0430\u044E\u0442\u044C \u0437\u043C\u043E\u0433\u0443
    \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043E\u043A\u0440\u0435\u043C\u0438\u0439
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0443 \u0444\u0430\u0439\u043B \u0430\u0431\u043E
    \u0456\u043C\u043F\u043E\u0440\u0442\u0443\u0432\u0430\u0442\u0438
    \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u0438\u0439 \u0444\u0430\u0439\u043B.
    \u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u043C\u0430\u0439\u0441\u0442\u0435\u0440
    \u043C\u043E\u0436\u0435 \u043D\u0430\u0434\u0456\u0441\u043B\u0430\u0442\u0438 \u0432\u0430\u043C
    \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442. \u041A\u043D\u043E\u043F\u043A\u0430 \u0437
    \u043A\u043E\u0448\u0438\u043A\u043E\u043C \u0432\u0438\u0434\u0430\u043B\u044F\u0454
    \u0432\u0438\u0431\u0440\u0430\u043D\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
  englishText: "The inventory has 5 pages with 9 items on each. You can choose a category for each item: weapons, armor, bags,
    magic items, miscellaneous, or custom image.\n\nIn the Custom Image category, you can add a picture from your
    gallery. In other categories, click the item\u2019s image to choose an icon from the list.\n\nUse the side
    buttons to export a single item to a file or import a file someone sent you. For example, your DM can send you a
    magic item. The trash button deletes the selected item."
  russianText: "\u0412 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 5 \u0441\u0442\u0440\u0430\u043D\u0438\u0446,
    \u043F\u043E 9 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432 \u043D\u0430
    \u043A\u0430\u0436\u0434\u043E\u0439. \u0414\u043B\u044F \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430
    \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044E: \u043E\u0440\u0443\u0436\u0438\u0435,
    \u0434\u043E\u0441\u043F\u0435\u0445\u0438, \u0441\u0443\u043C\u043A\u0438,
    \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B,
    \u0440\u0430\u0437\u043D\u043E\u0435 \u0438\u043B\u0438 \u0441\u0432\u043E\u0451
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435.\n\n\u0412
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438 \u00AB\u0421\u0432\u043E\u0451
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u00BB \u043C\u043E\u0436\u043D\u043E
    \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0443
    \u0438\u0437 \u0433\u0430\u043B\u0435\u0440\u0435\u0438. \u0412
    \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044F\u0445 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043D\u0430 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430, \u0447\u0442\u043E\u0431\u044B
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0437\u043D\u0430\u0447\u043E\u043A \u0438\u0437
    \u0441\u043F\u0438\u0441\u043A\u0430.\n\n\u0411\u043E\u043A\u043E\u0432\u044B\u0435
    \u043A\u043D\u043E\u043F\u043A\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0432 \u0444\u0430\u0439\u043B \u0438\u043B\u0438
    \u0438\u043C\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0439 \u0444\u0430\u0439\u043B.
    \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043C\u0430\u0441\u0442\u0435\u0440
    \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0441\u043B\u0430\u0442\u044C \u0432\u0430\u043C
    \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442.
    \u041A\u043D\u043E\u043F\u043A\u0430 \u0441 \u043A\u043E\u0440\u0437\u0438\u043D\u043E\u0439
    \u0443\u0434\u0430\u043B\u044F\u0435\u0442 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u0439
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
  useCurrentTextAsSource: 0
--- !u!114 &963000005
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
