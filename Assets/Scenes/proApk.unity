  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a179ec645311e874ba6d26be587cf8e2, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::ManualLocalizedText
  ukrainianText: "\u00AB\u0414\u0438\u043A\u0430 \u0444\u043E\u0440\u043C\u0430\u00BB \u2014 \u0446\u0435
    \u043C\u0456\u043D\u0456\u043A\u0430\u0440\u0442\u0430, \u043D\u0430 \u044F\u043A\u0456\u0439
    \u043C\u043E\u0436\u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0443\u0432\u0430\u0442\u0438
    \u0434\u0438\u043A\u0456 \u0444\u043E\u0440\u043C\u0438, \u0441\u0438\u043B\u043E\u0432\u0456
    \u0431\u0430\u043B\u0456\u0441\u0442\u0438, \u0444\u0430\u043C\u0456\u043B\u044C\u044F\u0440\u0456\u0432,
    \u043C\u043E\u043D\u0441\u0442\u0440\u0456\u0432, \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442
    \u0442\u0430 \u0456\u043D\u0448\u0456 \u043E\u0431\u2019\u0454\u043A\u0442\u0438, \u0434\u043B\u044F
    \u044F\u043A\u0438\u0445 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438 \u0439
    \u043E\u043F\u0438\u0441. \u0414\u043B\u044F \u0448\u0432\u0438\u0434\u043A\u043E\u0433\u043E
    \u043F\u0456\u0434\u0440\u0430\u0445\u0443\u043D\u043A\u0443 \u041E\u0417 \u0454 \u0448\u043A\u0430\u043B\u0430
    \u0436\u0438\u0442\u0442\u044F.\n\n\u0424\u043E\u0440\u043C\u0438 \u043C\u043E\u0436\u043D\u0430
    \u0434\u043E\u0434\u0430\u0432\u0430\u0442\u0438 \u0431\u0435\u0437
    \u043E\u0431\u043C\u0435\u0436\u0435\u043D\u044C. \u042F\u043A\u0449\u043E
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043E
    \u0447\u0435\u0440\u0435\u0437 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440, \u0443
    \u0441\u043F\u0438\u0441\u043A\u0443 \u0432\u043D\u0438\u0437\u0443
    \u0437\u2019\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456
    \u0434\u043B\u044F \u043D\u044C\u043E\u0433\u043E \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438.
    \u041E\u0431\u0435\u0440\u0456\u0442\u044C \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0443,
    \u0449\u043E\u0431 \u0434\u043E\u0434\u0430\u0442\u0438 \u0457\u0457 \u0434\u043E
    \u0441\u043F\u0438\u0441\u043A\u0443 \u0444\u043E\u0440\u043C.
    \u041F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043D\u044F \u0440\u0456\u0432\u043D\u044F
    \u0442\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u0435 \u043E\u043D\u043E\u0432\u0438\u0442\u0438
    \u0432\u0436\u0435 \u0434\u043E\u0434\u0430\u043D\u0456 \u0433\u043E\u0442\u043E\u0432\u0456
    \u0444\u043E\u0440\u043C\u0438, \u044F\u043A\u0449\u043E \u0446\u0435
    \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0435\u043D\u043E
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438 \u043A\u043B\u0430\u0441\u0443."
  englishText: "Wild Shape is a compact sheet for tracking wild shapes, force ballistas, familiars, monsters, vehicles, or
    anything else that needs stats and a description. It includes an HP bar for quick tracking.\n\nYou can add as
    many forms as you like. If the character was created with the generator, available presets appear in the list at
    the bottom. Choose a preset to add it to your forms. Leveling up can also update previously added preset forms if
    the class rules provide for it."
  russianText: "\u00AB\u0414\u0438\u043A\u0430\u044F \u0444\u043E\u0440\u043C\u0430\u00BB \u2014 \u044D\u0442\u043E
    \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0439 \u043B\u0438\u0441\u0442 \u0434\u043B\u044F
    \u0437\u0430\u043F\u0438\u0441\u0438 \u0434\u0438\u043A\u0438\u0445 \u043E\u0431\u043B\u0438\u043A\u043E\u0432,
    \u0441\u0438\u043B\u043E\u0432\u044B\u0445 \u0431\u0430\u043B\u043B\u0438\u0441\u0442,
    \u0444\u0430\u043C\u0438\u043B\u044C\u044F\u0440\u043E\u0432, \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432,
    \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445
    \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u043D\u0443\u0436\u043D\u044B
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438 \u0438
    \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435. \u0414\u043B\u044F
    \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043F\u043E\u0434\u0441\u0447\u0451\u0442\u0430
    \u0445\u0438\u0442\u043E\u0432 \u0435\u0441\u0442\u044C \u0448\u043A\u0430\u043B\u0430
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F.\n\n\u0424\u043E\u0440\u043C\u044B
    \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C \u0431\u0435\u0437
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0439. \u0415\u0441\u043B\u0438
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436 \u0441\u043E\u0437\u0434\u0430\u043D \u0432
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0435,
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438
    \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F \u0432 \u0441\u043F\u0438\u0441\u043A\u0435
    \u0432\u043D\u0438\u0437\u0443. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435
    \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0443, \u0447\u0442\u043E\u0431\u044B
    \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0435\u0451 \u043A \u0441\u0432\u043E\u0438\u043C
    \u0444\u043E\u0440\u043C\u0430\u043C. \u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
    \u0443\u0440\u043E\u0432\u043D\u044F \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442
    \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0442\u044C \u0443\u0436\u0435
    \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435 \u0433\u043E\u0442\u043E\u0432\u044B\u0435
    \u0444\u043E\u0440\u043C\u044B, \u0435\u0441\u043B\u0438 \u044D\u0442\u043E
    \u043F\u0440\u0435\u0434\u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u043E
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438 \u043A\u043B\u0430\u0441\u0441\u0430."
  useCurrentTextAsSource: 0
--- !u!114 &963000007
MonoBehaviour:
