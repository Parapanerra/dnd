  m_Text: "\u0422\u0443\u0442 \u043C\u043E\u0436\u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0443\u0432\u0430\u0442\u0438
    4-\u0440\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0456 \u043E\u043F\u0438\u0441\u0438
    \u0432\u0430\u0448\u0438\u0445 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0456\u0432,
    \u044F\u043A\u0449\u043E \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445
    \u043A\u0430\u0440\u0442 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430
    \u043D\u0435 \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u043B\u043E \u0430\u0431\u043E
    \u0436 \u044F\u043A\u0449\u043E \u0432\u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043D\u0430 \u0441\u0442\u0430\u0434\u0456\u0457 \u0456\u0434\u0435\u0457.\r\n\r\n\u042F\u043A\u0449\u043E
    \u0431\u0443\u0434\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E, \u0442\u0430\u043A\u043E\u0436
    \u043C\u043E\u0436\u0443 \u0434\u043E\u0434\u0430\u0442\u0438 \u0449\u0435 \u0435\u043A\u0441\u0442\u0440\u0430
    \u043F\u043E\u043B\u044F.\r\n"
