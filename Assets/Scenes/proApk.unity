  m_Script: {fileID: 11500000, guid: a179ec645311e874ba6d26be587cf8e2, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::ManualLocalizedText
  ukrainianText: "\u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u0434\u0430\u0454 \u0437\u043C\u043E\u0433\u0443
    \u0448\u0432\u0438\u0434\u043A\u043E \u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0438
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430, \u043E\u0431\u0440\u0430\u0432\u0448\u0438
    \u0440\u0456\u0432\u0435\u043D\u044C, \u043A\u043B\u0430\u0441, \u0440\u0430\u0441\u0443 \u0439
    \u043F\u0456\u0434\u043A\u043B\u0430\u0441 \u0437\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438
    D&D 5e 2014 \u0430\u0431\u043E 2024
    \u0440\u043E\u043A\u0443.\n\n\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E
    \u0437\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0456 \u043A\u0430\u0440\u0442\u0438
    \u043C\u043E\u0436\u0443\u0442\u044C \u043C\u0456\u0441\u0442\u0438\u0442\u0438
    \u043D\u0435\u0442\u043E\u0447\u043D\u0456 \u0430\u0431\u043E \u043D\u0435\u043F\u043E\u0432\u043D\u0456
    \u043E\u043F\u0438\u0441\u0438. \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u0439\u0442\u0435
    \u0432\u0430\u0436\u043B\u0438\u0432\u0456 \u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456 \u0437\u0430
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438 \u043E\u0431\u0440\u0430\u043D\u043E\u0457
    \u0440\u0435\u0434\u0430\u043A\u0446\u0456\u0457, \u0430\u0434\u0436\u0435
    \u0432\u0440\u0430\u0445\u0443\u0432\u0430\u0442\u0438 \u0432\u0441\u0456
    \u043C\u043E\u0436\u043B\u0438\u0432\u0456 \u043F\u043E\u0454\u0434\u043D\u0430\u043D\u043D\u044F
    \u0441\u043A\u043B\u0430\u0434\u043D\u043E.\n\n\u041C\u0430\u0439\u0441\u0442\u0435\u0440
    \u043F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043D\u044F \u0440\u0456\u0432\u043D\u044F
    \u043E\u043D\u043E\u0432\u043B\u044E\u0454 \u043A\u0430\u0440\u0442\u0443 \u0437\u0430
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438 \u043E\u0431\u0440\u0430\u043D\u043E\u0457
    \u0440\u0435\u0434\u0430\u043A\u0446\u0456\u0457. \u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u0442\u0430\u043A\u043E\u0436 \u0437\u0430\u043F\u0438\u0441\u0443\u0454 \u0432\u0456\u0434\u043E\u043C\u0456
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0443
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u043D\u044F \u0439 \u0434\u043E\u0434\u0430\u0454
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456 \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438
    \u0444\u0430\u043C\u0456\u043B\u044C\u044F\u0440\u0456\u0432,
    \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0446\u0456\u0432, \u0434\u0438\u043A\u0438\u0445
    \u0444\u043E\u0440\u043C \u0442\u0430 \u0456\u043D\u0448\u0438\u0445
    \u0441\u0443\u043F\u0443\u0442\u043D\u0438\u043A\u0456\u0432 \u0434\u043E \u0441\u043F\u0438\u0441\u043A\u0443
    \u043D\u0430 \u0441\u0442\u043E\u0440\u0456\u043D\u0446\u0456 \u00AB\u0414\u0438\u043A\u0430
    \u0444\u043E\u0440\u043C\u0430\u00BB."
  englishText: "The generator lets you quickly create a character by choosing a level, class, species, and subclass under the
    2014 or 2024 D&D 5e rules.\n\nAutomatically filled sheets may contain incomplete or inaccurate descriptions.
    Check important details against the rules of your chosen edition, as it is difficult to cover every possible
    combination.\n\nThe level-up wizard updates the sheet using your chosen edition\u2019s rules. The generator also
    records the character\u2019s known spells and adds available presets for familiars, pets, wild shapes, and other
    companions to the list on the Wild Shape page."
  russianText: "\u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u0431\u044B\u0441\u0442\u0440\u043E \u0441\u043E\u0437\u0434\u0430\u0442\u044C
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430, \u0432\u044B\u0431\u0440\u0430\u0432
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C, \u043A\u043B\u0430\u0441\u0441, \u0440\u0430\u0441\u0443 \u0438
    \u043F\u043E\u0434\u043A\u043B\u0430\u0441\u0441 \u043F\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C
    D&D 5e 2014 \u0438\u043B\u0438 2024
    \u0433\u043E\u0434\u0430.\n\n\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0435 \u043B\u0438\u0441\u0442\u044B
    \u043C\u043E\u0433\u0443\u0442 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u043D\u0435\u0442\u043E\u0447\u043D\u044B\u0435 \u0438\u043B\u0438
    \u043D\u0435\u043F\u043E\u043B\u043D\u044B\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F.
    \u0421\u0432\u0435\u0440\u044F\u0439\u0442\u0435 \u0432\u0430\u0436\u043D\u044B\u0435
    \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0441 \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438
    \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0439 \u0440\u0435\u0434\u0430\u043A\u0446\u0438\u0438,
    \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u0443\u0447\u0435\u0441\u0442\u044C \u0432\u0441\u0435
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u044F
    \u0441\u043B\u043E\u0436\u043D\u043E.\n\n\u041C\u0430\u0441\u0442\u0435\u0440
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u0443\u0440\u043E\u0432\u043D\u044F
    \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442 \u043B\u0438\u0441\u0442 \u043F\u043E
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0439
    \u0440\u0435\u0434\u0430\u043A\u0446\u0438\u0438. \u0413\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u0442\u0430\u043A\u0436\u0435 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0443
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F \u0438
    \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435
    \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438
    \u0444\u0430\u043C\u0438\u043B\u044C\u044F\u0440\u043E\u0432, \u043F\u0438\u0442\u043E\u043C\u0446\u0435\u0432,
    \u0434\u0438\u043A\u0438\u0445 \u043E\u0431\u043B\u0438\u043A\u043E\u0432 \u0438
    \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432 \u0432
    \u0441\u043F\u0438\u0441\u043E\u043A \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435
    \u00AB\u0414\u0438\u043A\u0430\u044F \u0444\u043E\u0440\u043C\u0430\u00BB."
  useCurrentTextAsSource: 0
