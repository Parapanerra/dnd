  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a179ec645311e874ba6d26be587cf8e2, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::ManualLocalizedText
  ukrainianText: "\u0413\u0430\u043B\u0435\u0440\u0435\u044F \u2014 \u0446\u0435 \u0430\u043B\u044C\u0431\u043E\u043C
    \u0434\u043B\u044F \u0456\u0433\u0440\u043E\u0432\u0438\u0445
    \u0440\u043E\u0437\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0445
    \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0432: \u043A\u0430\u0440\u0442,
    \u0437\u0430\u043F\u0438\u0441\u043E\u043A \u0442\u0430 \u0456\u043D\u0448\u0438\u0445
    \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u044C, \u044F\u043A\u0456 \u0434\u0430\u0454
    \u043C\u0430\u0439\u0441\u0442\u0435\u0440. \u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u043D\u0430
    \u0434\u043E\u0434\u0430\u043D\u0435 \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F,
    \u0449\u043E\u0431 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438 \u0439\u043E\u0433\u043E \u0434\u043B\u044F
    \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u0443."
  englishText: "The gallery is an album for game handouts: maps, notes, and other images from your DM. Click an image
    you\u2019ve added to open it for viewing."
  russianText: "\u0413\u0430\u043B\u0435\u0440\u0435\u044F \u2014 \u044D\u0442\u043E \u0430\u043B\u044C\u0431\u043E\u043C
    \u0434\u043B\u044F \u0438\u0433\u0440\u043E\u0432\u044B\u0445
    \u0440\u0430\u0437\u0434\u0430\u0442\u043E\u0447\u043D\u044B\u0445
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432: \u043A\u0430\u0440\u0442,
    \u0437\u0430\u043F\u0438\u0441\u043E\u043A \u0438 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0439 \u043E\u0442
    \u043C\u0430\u0441\u0442\u0435\u0440\u0430. \u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430
    \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B
    \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0435\u0433\u043E \u0434\u043B\u044F
    \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430."
  useCurrentTextAsSource: 0
--- !u!114 &963000006
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
