  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a179ec645311e874ba6d26be587cf8e2, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::ManualLocalizedText
  ukrainianText: "\u0422\u0443\u0442 \u043C\u043E\u0436\u043D\u0430 \u043E\u043F\u0438\u0441\u0430\u0442\u0438
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430, \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u0438
    \u0441\u044E\u0436\u0435\u0442\u043D\u0456 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F \u0439
    \u0432\u0456\u0434\u043C\u0456\u0447\u0430\u0442\u0438 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u0456.
    \u042F\u043A\u0449\u043E \u043D\u043E\u0442\u0430\u0442\u043E\u043A \u043D\u0430
    \u0433\u043E\u043B\u043E\u0432\u043D\u0456\u0439 \u0441\u0442\u043E\u0440\u0456\u043D\u0446\u0456
    \u043A\u0430\u0440\u0442\u0438 \u0437\u0430\u043C\u0430\u043B\u043E,
    \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0439\u0442\u0435\u0441\u044F
    \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u043C\u0438 \u043F\u043E\u043B\u044F\u043C\u0438.
    \u0422\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u043D\u0430
    \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438 \u0444\u043E\u0442\u043E
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u0437 \u0433\u0430\u043B\u0435\u0440\u0435\u0457."
  englishText: "Here you can describe your character, keep track of quests, and mark them as completed. If you need more room
    than the notes on the main sheet provide, use the extra fields here. You can also upload a character image from
    your gallery."
  russianText: "\u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u043E\u043F\u0438\u0441\u0430\u0442\u044C
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430, \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C
    \u0441\u044E\u0436\u0435\u0442\u043D\u044B\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0438
    \u043E\u0442\u043C\u0435\u0447\u0430\u0442\u044C
    \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0435. \u0415\u0441\u043B\u0438 \u043D\u0430
    \u0433\u043B\u0430\u0432\u043D\u043E\u0439 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435
    \u043B\u0438\u0441\u0442\u0430 \u043C\u0430\u043B\u043E \u043C\u0435\u0441\u0442\u0430 \u0434\u043B\u044F
    \u0437\u0430\u043C\u0435\u0442\u043E\u043A,
    \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435\u0441\u044C
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
