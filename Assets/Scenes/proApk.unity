  ukrainianText: "0. \u0423 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u043C\u0443 \u043C\u0435\u043D\u044E
    \u043C\u043E\u0436\u043D\u0430 \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438
    \u043A\u0456\u043B\u044C\u043A\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0456\u0432.
    \u041A\u043D\u043E\u043F\u043A\u0430 \u0437 \u0434\u0438\u0441\u043A\u0435\u0442\u043E\u044E \u0434\u0430\u0454
    \u0437\u043C\u043E\u0433\u0443 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0443 \u0444\u0430\u0439\u043B
    \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u0430\u0431\u043E
    \u0432\u0441\u044E \u043A\u043E\u043B\u0435\u043A\u0446\u0456\u044E \u0434\u043B\u044F
    \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0435\u043D\u043D\u044F \u043C\u0456\u0436
    \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u044F\u043C\u0438.\n\n1. \u0428\u043A\u0430\u043B\u0430 \u041E\u0417.
    \u0423 \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440\u0456 \u043C\u043E\u0436\u043D\u0430
    \u0437\u0430\u0434\u0430\u0442\u0438 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0456 \u0439
    \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u0456 \u041E\u0417,
    \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438 \u0448\u043A\u043E\u0434\u0443
    \u0430\u0431\u043E \u0437\u0446\u0456\u043B\u0435\u043D\u043D\u044F. \u0423\u043D\u0438\u0437\u0443
    \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440\u0430 \u0454
    \u0441\u043F\u0438\u0441\u043E\u043A \u0437\u0456\u043B\u043B\u044F
    \u0437\u0446\u0456\u043B\u0435\u043D\u043D\u044F. \u041E\u0431\u0435\u0440\u0456\u0442\u044C
    \u0437\u0456\u043B\u043B\u044F \u0442\u0430 \u0432\u0438\u043F\u0438\u0439\u0442\u0435 \u0439\u043E\u0433\u043E,
    \u0456 \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440
    \u043F\u043E\u0440\u0430\u0445\u0443\u0454, \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u041E\u0417
    \u0432\u043E\u043D\u043E \u0432\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u044C.\n\n2.
    \u041D\u0430\u0432\u0438\u0447\u043A\u0438. \u041A\u0430\u0440\u0442\u0430
    \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u044C
    \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440\u0438
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A \u0443
    \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0456 \u043D\u0430\u0432\u0438\u0447\u043A\u0438.
    \u042F\u043A\u0449\u043E \u043F\u043E\u0437\u043D\u0430\u0447\u0438\u0442\u0438
    \u0432\u043E\u043B\u043E\u0434\u0456\u043D\u043D\u044F \u043D\u0430\u0432\u0438\u0447\u043A\u043E\u044E,
    \u0434\u043E \u0457\u0457 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F
    \u0434\u043E\u0434\u0430\u0454\u0442\u044C\u0441\u044F \u0431\u043E\u043D\u0443\u0441
    \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u043E\u0441\u0442\u0456.
    \u0417\u043D\u0430\u0447\u0435\u043D\u043D\u044F \u043C\u043E\u0436\u043D\u0430
    \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u0432\u0440\u0443\u0447\u043D\u0443. \u041A\u043E\u043B\u0438
    \u0437\u043C\u0456\u043D\u044E\u0454\u0442\u044C\u0441\u044F
    \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0430
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430 \u0430\u0431\u043E
    \u0431\u043E\u043D\u0443\u0441 \u043C\u0430\u0439\u0441\u0442\u0435\u0440\u043D\u043E\u0441\u0442\u0456,
    \u043A\u0430\u0440\u0442\u0430 \u0437\u043D\u043E\u0432\u0443
    \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0454 \u0439\u043E\u0433\u043E
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E.\n\n3.
    \u0411\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0438. \u0412\u0432\u0435\u0434\u0456\u0442\u044C
    \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u0441\u0442\u0440\u0456\u043B,
    \u0431\u043E\u043B\u0442\u0456\u0432 \u0447\u0438 \u0456\u043D\u0448\u0438\u0445
    \u0431\u043E\u0454\u043F\u0440\u0438\u043F\u0430\u0441\u0456\u0432.
    \u0421\u0442\u0440\u0456\u043B\u043A\u0430\u043C\u0438 \u043C\u043E\u0436\u043D\u0430
    \u0437\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u0438 \u0430\u0431\u043E
    \u0437\u043C\u0435\u043D\u0448\u0438\u0442\u0438 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
    \u043D\u0430 \u043E\u0434\u0438\u043D\u0438\u0446\u044E.\n\n4. \u0417\u0456\u043B\u043B\u044F.
    \u041C\u043E\u0436\u043D\u0430 \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u0438 \u0434\u043E
    \u043F\u2019\u044F\u0442\u0438 \u0432\u0438\u0434\u0456\u0432 \u0437\u0456\u043B\u043B\u044F,
    \u0443\u043A\u0430\u0437\u0430\u0442\u0438 \u0457\u0445\u043D\u0456 \u043D\u0430\u0437\u0432\u0438 \u0439
    \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C. \u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
    \u043D\u0430 \u0456\u043A\u043E\u043D\u043A\u0443, \u0449\u043E\u0431 \u0432\u0438\u0431\u0440\u0430\u0442\u0438
    \u043E\u0434\u043D\u0443 \u0437 13 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u043A.
    \u041A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u043C\u043E\u0436\u043D\u0430
    \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u0441\u0442\u0440\u0456\u043B\u043A\u0430\u043C\u0438.\n\n5.
    \u0420\u0435\u0441\u0443\u0440\u0441\u0438 \u043A\u043B\u0430\u0441\u0443 \u0430\u0431\u043E
    \u0440\u0430\u0441\u0438. \u0423 \u0441\u043F\u0438\u0441\u043A\u0443 \u043C\u043E\u0436\u043D\u0430
    \u043E\u0431\u0440\u0430\u0442\u0438 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0439
    \u0440\u0435\u0441\u0443\u0440\u0441, \u043D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434
    \u043C\u0435\u0442\u0430\u043C\u0430\u0433\u0456\u044E, \u0443\u043A\u0430\u0437\u0430\u0442\u0438
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0443 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u0456
    \u043F\u043E\u0437\u043D\u0430\u0447\u0430\u0442\u0438, \u0441\u043A\u0456\u043B\u044C\u043A\u0438
    \u0440\u0430\u0437\u0456\u0432 \u0440\u0435\u0441\u0443\u0440\u0441 \u0443\u0436\u0435
    \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E.\n\n6.
    \u041C\u0443\u043B\u044C\u0442\u0438\u043A\u043B\u0430\u0441. \u041A\u043D\u043E\u043F\u043A\u0430
    \u00AB\u041C\u0443\u043B\u044C\u0442\u0438\u043A\u043B\u0430\u0441\u00BB \u0431\u0456\u043B\u044F
    \u0456\u043C\u0435\u043D\u0456 \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454
    \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0456 \u043F\u043E\u043B\u044F \u0434\u043B\u044F
    \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043A\u043B\u0430\u0441\u0443.\n\n7.
    \u0422\u0430\u0431\u043B\u0438\u0446\u044F
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A.
    \u041A\u043D\u043E\u043F\u043A\u0430 \u043B\u0456\u0432\u043E\u0440\u0443\u0447 \u0432\u0456\u0434
    \u043A\u0430\u0440\u0442\u0438 \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u0454
    \u0442\u0430\u0431\u043B\u0438\u0446\u044E \u0437\u0456
    \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F\u043C\u0438
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A \u0442\u0430
    \u0457\u0445\u043D\u0456\u043C\u0438
    \u043C\u043E\u0434\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440\u0430\u043C\u0438.\n\n8.
    \u041D\u043E\u0442\u0430\u0442\u043A\u0438. \u0412\u0456\u0441\u0456\u043C \u043A\u043D\u043E\u043F\u043E\u043A
    \u043B\u0456\u0432\u043E\u0440\u0443\u0447 \u0456 \u043F\u0440\u0430\u0432\u043E\u0440\u0443\u0447
    \u0432\u0456\u0434 \u043A\u0430\u0440\u0442\u0438
    \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0430\u044E\u0442\u044C
    \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0456 \u043F\u043E\u043B\u044F \u0434\u043B\u044F
    \u043D\u043E\u0442\u0430\u0442\u043E\u043A.\n\n9.
    \u041A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440. \u041E\u0431\u0435\u0440\u0456\u0442\u044C
    \u043A\u0456\u0441\u0442\u043A\u0443 \u0439 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u00AB=\u00BB,
    \u0449\u043E\u0431 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u043A\u0438\u0434\u043E\u043A.
    \u041A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440 \u0442\u0430\u043A\u043E\u0436
    \u0440\u0430\u0445\u0443\u0454 \u0432\u0438\u0440\u0430\u0437\u0438 \u043D\u0430
    \u043A\u0448\u0442\u0430\u043B\u0442 2d10+1d8+1d4+2 \u0430\u0431\u043E 4d4+4 \u0456 \u043C\u043E\u0436\u0435
    \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u044F\u043A \u0448\u043A\u043E\u0434\u0443 \u0447\u0438
    \u0437\u0446\u0456\u043B\u0435\u043D\u043D\u044F. \u041A\u043D\u043E\u043F\u043A\u0438
    \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0433\u043E \u0439 \u0434\u043E\u0432\u0433\u043E\u0433\u043E
    \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043D\u043A\u0443
    \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u044E\u0442\u044C \u041E\u0417,
    \u043A\u043E\u043C\u0456\u0440\u043A\u0438 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u044C \u0456
    \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043D\u044F \u0432\u043C\u0456\u043D\u044C
    \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E \u0434\u043E \u0432\u0438\u0434\u0443
    \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043D\u043A\u0443. \u041A\u043D\u043E\u043F\u043A\u0430
    \u00AB\u0406\u0441\u0442\u043E\u0440\u0456\u044F\u00BB \u043F\u043E\u043A\u0430\u0437\u0443\u0454
    \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u0456
    \u043E\u0431\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044F.\n\n10.
    \u041F\u0456\u0434\u0432\u0438\u0449\u0435\u043D\u043D\u044F \u0440\u0456\u0432\u043D\u044F.
    \u041C\u0430\u0439\u0441\u0442\u0435\u0440 \u0434\u043E\u0434\u0430\u0454
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0443 \u043E\u0434\u0438\u043D
    \u0440\u0456\u0432\u0435\u043D\u044C. \u041A\u043D\u043E\u043F\u043A\u0430
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0434\u043B\u044F
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0456\u0432,
    \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0445 \u0447\u0435\u0440\u0435\u0437
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440, \u0434\u043E 20-\u0433\u043E
    \u0440\u0456\u0432\u043D\u044F. \u042F\u043A\u0449\u043E \u043A\u0430\u0440\u0442\u0443
    \u0437\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u043E \u0432\u0440\u0443\u0447\u043D\u0443,
    \u0437\u043C\u0456\u043D\u0438 \u0440\u0456\u0432\u043D\u044F \u0442\u0430\u043A\u043E\u0436
    \u0432\u043D\u043E\u0441\u044F\u0442\u044C\u0441\u044F \u0432\u0440\u0443\u0447\u043D\u0443."
  englishText: "0. You can create multiple characters from the main menu. Use the floppy disk button to save a single character
    or your entire collection to a file for transfer between devices.\n\n1. HP bar. In the calculator, you can set
    maximum and temporary HP and apply damage or healing. Choose and drink a healing potion from the list at the
    bottom of the calculator to roll how much HP it restores.\n\n2. Skills. The sheet applies ability modifiers to
    the corresponding skills. Mark a skill as proficient to include your proficiency bonus. You can edit a value
    manually. The sheet recalculates it when the corresponding ability score or proficiency bonus changes.\n\n3.
    Ammunition. Enter the number of arrows, bolts, or other ammunition. Use the arrow buttons to increase or decrease
    the count by one.\n\n4. Potions. You can track up to five types of potions, with a name and a quantity for each.
    Click an icon to choose one of 13 images. Use the arrows to adjust the quantity.\n\n5. Class or species
    resources. Choose a resource such as Metamagic from the list, set the number of uses available, and mark off
    spent uses.\n\n6. Multiclassing. The Multiclass button next to the character name opens fields for the second
    class.\n\n7. Ability score table. The button to the left of the sheet opens a table of ability scores and their
    modifiers.\n\n8. Notes. Eight buttons to the left and right of the sheet open additional note fields.\n\n9.
    Calculator. Choose a die and press \u201C=\u201D to roll. The calculator also evaluates expressions such as
    2d10+1d8+1d4+2 or 4d4+4 and can apply the result as damage or healing. The Short Rest and Long Rest buttons
    restore HP, spell slots, and feature uses as appropriate for each type of rest. The History button shows past
    calculations.\n\n10. Level Up. The wizard adds one level to the character. The button is available to characters
    created with the generator until they reach level 20. For manually filled sheets, update the level and other
    changes by hand."
  russianText: "0. \u0412 \u0433\u043B\u0430\u0432\u043D\u043E\u043C \u043C\u0435\u043D\u044E \u043C\u043E\u0436\u043D\u043E
    \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439. \u041A\u043D\u043E\u043F\u043A\u0430 \u0441
    \u0434\u0438\u0441\u043A\u0435\u0442\u043E\u0439 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0432 \u0444\u0430\u0439\u043B
    \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u0438\u043B\u0438
    \u0432\u0441\u044E \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044E \u0434\u043B\u044F
    \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0430 \u043C\u0435\u0436\u0434\u0443
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438.\n\n1. \u0428\u043A\u0430\u043B\u0430
    \u0445\u0438\u0442\u043E\u0432. \u0412 \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440\u0435
    \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u0434\u0430\u0442\u044C
    \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u0438
    \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0445\u0438\u0442\u044B,
    \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C \u0443\u0440\u043E\u043D \u0438\u043B\u0438
    \u043B\u0435\u0447\u0435\u043D\u0438\u0435. \u0412\u043D\u0438\u0437\u0443
    \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440\u0430 \u0435\u0441\u0442\u044C
    \u0441\u043F\u0438\u0441\u043E\u043A \u0437\u0435\u043B\u0438\u0439 \u043B\u0435\u0447\u0435\u043D\u0438\u044F.
    \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0438 \u0432\u044B\u043F\u0435\u0439\u0442\u0435
    \u0437\u0435\u043B\u044C\u0435, \u0438 \u043A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0445\u0438\u0442\u043E\u0432 \u043E\u043D\u043E
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442.\n\n2. \u041D\u0430\u0432\u044B\u043A\u0438.
    \u041B\u0438\u0441\u0442 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442
    \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u044B
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A \u0432
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
    \u043D\u0430\u0432\u044B\u043A\u0438. \u0415\u0441\u043B\u0438 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C
    \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u0435 \u043D\u0430\u0432\u044B\u043A\u043E\u043C, \u043A
    \u0435\u0433\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044E
    \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0431\u043E\u043D\u0443\u0441
    \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430. \u0417\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u043C\u043E\u0436\u043D\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
    \u0432\u0440\u0443\u0447\u043D\u0443\u044E. \u041F\u0440\u0438
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0438
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438 \u0438\u043B\u0438
    \u0431\u043E\u043D\u0443\u0441\u0430 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430
    \u043B\u0438\u0441\u0442 \u0441\u043D\u043E\u0432\u0430
    \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442 \u0435\u0433\u043E
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.\n\n3.
    \u0411\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u0412\u0432\u0435\u0434\u0438\u0442\u0435
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0441\u0442\u0440\u0435\u043B,
    \u0431\u043E\u043B\u0442\u043E\u0432 \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0431\u043E\u0435\u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432. \u0421\u0442\u0440\u0435\u043B\u043A\u0438
    \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442 \u0438\u043B\u0438
    \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u044E\u0442
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043D\u0430
    \u0435\u0434\u0438\u043D\u0438\u0446\u0443.\n\n4. \u0417\u0435\u043B\u044C\u044F. \u041C\u043E\u0436\u043D\u043E
    \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u0434\u043E \u043F\u044F\u0442\u0438
    \u0432\u0438\u0434\u043E\u0432 \u0437\u0435\u043B\u0438\u0439, \u0443\u043A\u0430\u0437\u0430\u0432 \u0438\u0445
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u0438
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043D\u0430 \u0437\u043D\u0430\u0447\u043E\u043A, \u0447\u0442\u043E\u0431\u044B
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043E\u0434\u043D\u043E \u0438\u0437 13
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0439.
    \u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043C\u043E\u0436\u043D\u043E
    \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0441\u0442\u0440\u0435\u043B\u043A\u0430\u043C\u0438.\n\n5.
    \u0420\u0435\u0441\u0443\u0440\u0441\u044B \u043A\u043B\u0430\u0441\u0441\u0430 \u0438\u043B\u0438
    \u0440\u0430\u0441\u044B. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0440\u0435\u0441\u0443\u0440\u0441,
    \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u043C\u0435\u0442\u0430\u043C\u0430\u0433\u0438\u044E,
    \u0443\u043A\u0430\u0436\u0438\u0442\u0435 \u0447\u0438\u0441\u043B\u043E
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0445
    \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0439 \u0438
    \u043E\u0442\u043C\u0435\u0447\u0430\u0439\u0442\u0435
    \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u0435.\n\n6.
    \u041C\u0443\u043B\u044C\u0442\u0438\u043A\u043B\u0430\u0441\u0441. \u041A\u043D\u043E\u043F\u043A\u0430
    \u00AB\u041C\u0443\u043B\u044C\u0442\u0438\u043A\u043B\u0430\u0441\u0441\u00BB \u0440\u044F\u0434\u043E\u043C
    \u0441 \u0438\u043C\u0435\u043D\u0435\u043C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u043B\u044F
    \u0434\u043B\u044F \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0430.\n\n7.
    \u0422\u0430\u0431\u043B\u0438\u0446\u0430
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A.
    \u041A\u043D\u043E\u043F\u043A\u0430 \u0441\u043B\u0435\u0432\u0430 \u043E\u0442 \u043B\u0438\u0441\u0442\u0430
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0442\u0430\u0431\u043B\u0438\u0446\u0443 \u0441\u043E
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F\u043C\u0438
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A \u0438 \u0438\u0445
    \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u0430\u043C\u0438.\n\n8.
    \u0417\u0430\u043C\u0435\u0442\u043A\u0438. \u0412\u043E\u0441\u0435\u043C\u044C
    \u043A\u043D\u043E\u043F\u043E\u043A \u0441\u043B\u0435\u0432\u0430 \u0438 \u0441\u043F\u0440\u0430\u0432\u0430
    \u043E\u0442 \u043B\u0438\u0441\u0442\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u043B\u044F
    \u0434\u043B\u044F \u0437\u0430\u043C\u0435\u0442\u043E\u043A.\n\n9.
    \u041A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440.
    \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u043E\u0441\u0442\u044C \u0438
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u00AB=\u00BB, \u0447\u0442\u043E\u0431\u044B
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0431\u0440\u043E\u0441\u043E\u043A.
    \u041A\u0430\u043B\u044C\u043A\u0443\u043B\u044F\u0442\u043E\u0440 \u0442\u0430\u043A\u0436\u0435
    \u0432\u044B\u0447\u0438\u0441\u043B\u044F\u0435\u0442 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u044F
    \u0432\u0440\u043E\u0434\u0435 2d10+1d8+1d4+2 \u0438\u043B\u0438 4d4+4 \u0438 \u043C\u043E\u0436\u0435\u0442
    \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u043A\u0430\u043A \u0443\u0440\u043E\u043D \u0438\u043B\u0438 \u043B\u0435\u0447\u0435\u043D\u0438\u0435.
    \u041A\u043D\u043E\u043F\u043A\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0433\u043E \u0438
    \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u0442\u0434\u044B\u0445\u0430
    \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442
    \u0445\u0438\u0442\u044B, \u044F\u0447\u0435\u0439\u043A\u0438
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439 \u0438
    \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0443\u043C\u0435\u043D\u0438\u0439 \u0432
    \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0432\u0438\u0434\u0430
    \u043E\u0442\u0434\u044B\u0445\u0430. \u041A\u043D\u043E\u043F\u043A\u0430
    \u00AB\u0418\u0441\u0442\u043E\u0440\u0438\u044F\u00BB
    \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0435
    \u0432\u044B\u0447\u0438\u0441\u043B\u0435\u043D\u0438\u044F.\n\n10.
    \u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u0443\u0440\u043E\u0432\u043D\u044F.
    \u041C\u0430\u0441\u0442\u0435\u0440 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0443 \u043E\u0434\u0438\u043D
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C. \u041A\u043D\u043E\u043F\u043A\u0430
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430\u043C,
    \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u043C \u0432
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0435, \u0434\u043E
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F 20-\u0433\u043E
    \u0443\u0440\u043E\u0432\u043D\u044F. \u0415\u0441\u043B\u0438 \u043B\u0438\u0441\u0442
    \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D \u0432\u0440\u0443\u0447\u043D\u0443\u044E,
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043F\u0440\u0438
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0438 \u0443\u0440\u043E\u0432\u043D\u044F
    \u0442\u0430\u043A\u0436\u0435 \u0432\u043D\u043E\u0441\u044F\u0442\u0441\u044F
    \u0432\u0440\u0443\u0447\u043D\u0443\u044E."
