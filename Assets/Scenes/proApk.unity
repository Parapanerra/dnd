  m_Text: "\u0426\u0435 \u043F\u043E \u0441\u0432\u043E\u0457\u0439 \u0441\u0443\u0442\u0456
    \u043C\u0456\u043D\u0456\u043A\u0430\u0440\u0442\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430,
    \u044F\u043A\u0443 \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
    \u0434\u043B\u044F \u0437\u0430\u043F\u0438\u0441\u0443 \u0434\u0438\u043A\u0438\u0445
    \u0444\u043E\u0440\u043C, \u0441\u0438\u043B\u043E\u0432\u0438\u0445 \u0431\u0430\u043B\u0456\u0441\u0442,
    \u0444\u0430\u043C\u0456\u043B\u044C\u044F\u0440\u0456\u0432, \u043C\u043E\u043D\u0441\u0442\u0440\u0456\u0432,
    \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0443 \u0456 \u0432\u0437\u0430\u0433\u0430\u043B\u0456
    \u0431\u0443\u0434\u044C-\u0447\u043E\u0433\u043E, \u0449\u043E \u0432\u0438
    \u0437\u0430\u0431\u0430\u0436\u0430\u0454\u0442\u0435, \u044F\u043A\u0449\u043E
    \u0432 \u043D\u0438\u0445 \u0454 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
    \u0439 \u043E\u043F\u0438\u0441. \u0422\u0443\u0442 \u0442\u0430\u043A\u043E\u0436
    \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u0456 \u041B\u0456\u043D\u0456\u0457
    \u0416\u0438\u0442\u0442\u044F \u0434\u043B\u044F \u0448\u0432\u0438\u0434\u043A\u043E\u0433\u043E
    \u043F\u0456\u0434\u0440\u0430\u0445\u0443\u043D\u043A\u0443.\r\n\r\n\u0421\u0430\u043C\u0438\u0445
    \u0414\u0438\u043A\u0438\u0445 \u0444\u043E\u0440\u043C \u0454 \u043F\u043E 4-\u0440\u0438
    \u0432 \u043A\u043E\u0436\u043D\u0456\u0439 \u043A\u0430\u0440\u0442\u0456 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430.
    \u042F\u043A\u0449\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0431\u0443\u0434\u0435
    \u0431\u0456\u043B\u044C\u0448\u0435, \u043F\u0438\u0448\u0456\u0442\u044C \u0443
    \u043A\u043E\u043C\u0435\u043D\u0442\u0430\u0440\u044F\u0445 \u0433\u0440\u0443\u043F\u0438
    \u0434\u043E\u0434\u0430\u0442\u043A\u0430 (\u043F\u043E\u0441\u0438\u043B\u0430\u043D\u043D\u044F
    \u043D\u0430 \u0433\u0440\u0443\u043F\u0443 \u0443 \u0432\u043A\u043B\u0430\u0434\u0446\u0456
    \u0410\u0432\u0442\u043E\u0440\u0438).\r\n"
