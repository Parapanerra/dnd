    m_LineSpacing: 1
  m_Text: "\u0426\u0435\u0439 \u0434\u043E\u0434\u0430\u0442\u043E\u043A, \u0437\u0432\u0456\u0441\u043D\u043E,
    \u0431\u0443\u0434\u0435 \u0449\u0435 \u0434\u043E\u0431\u0440\u0430\u0446\u044C\u043E\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044C
    \u0456, \u044F\u043A\u0449\u043E \u0443 \u0432\u0430\u0441 \u0454 \u0437\u0430\u0443\u0432\u0430\u0436\u0435\u043D\u043D\u044F
    \u0430\u0431\u043E \u043F\u043E\u0431\u0430\u0436\u0430\u043D\u043D\u044F, \u0432\u0438
    \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u0438
    \u043F\u0440\u043E \u0446\u0435 \u0432 \u043A\u043E\u043C\u0435\u043D\u0442\u0430\u0440\u044F\u0445
    \u0433\u0440\u0443\u043F\u0438. \n"
